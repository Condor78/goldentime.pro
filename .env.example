# Server
PORT=3000

# Gmail OAuth (Google Cloud Console -> OAuth client ID, type "Web application")
# Authorized redirect URI must match GMAIL_REDIRECT_URI below.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Gmail account expected (read-only check, opzionale)
GMAIL_EXPECTED_USER=prenotazioni40@gmail.com

# Filtro mail KrossBooking (Gmail search query)
GMAIL_SEARCH_QUERY=from:(krossbooking) newer_than:90d
